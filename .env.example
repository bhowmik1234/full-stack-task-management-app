# Root .env — read by docker compose only. Copy to .env on the VPS and fill in.
# backend/.env and client/.env stay as they are for local `npm run dev`.

# ---- database ----
# Credentials for the bundled postgres service.
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=
POSTGRES_DB=ecommerce
# Host port to expose postgres on. Only needed to run migrations from the host.
POSTGRES_PORT=5432
# Connection string the backend uses. Inside compose the host is the service
# name `db`; from the host it is localhost:${POSTGRES_PORT}.
DATABASE_URL=postgresql://ecommerce:PASSWORD@db:5432/ecommerce?schema=public

# ---- backend runtime ----
# Comma-separated origins allowed to call the API cross-origin. Behind the
# compose nginx the SPA is same-origin, so leaving this empty is correct there;
# with NODE_ENV=production an empty value denies cross-origin rather than
# allowing everything. Set it only if the client is served from another domain.
CLIENT_URL=
# Origin the admin console is served from. Two things read it:
#   - the backend, which refuses any admin request whose browser Origin is
#     something else (backend/src/middlewares/auth.ts), and adds it to CORS;
#   - the storefront build, which uses it for the "Admin console" link in the
#     account menu — leave it empty and the link is not rendered at all.
# Must match the host nginx serves admin.html on, i.e. app.admin.<your domain>.
# Point that DNS record at the same server as the storefront.
ADMIN_URL=https://app.admin.your-domain.com

# ---- console sign-in (firebase admin sdk) ----
# The console authenticates with a Firebase ID token, verified here — not with
# the `?id=<uid>` the storefront uses. That is what lets the server enforce
# *how* an operator signed in; a restriction in the console's own UI is bypassed
# by signing in on the shop and calling the admin API directly.
#
# From the Firebase console → Project settings → Service accounts → Generate new
# private key. Three fields out of that JSON:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the surrounding quotes and the literal \n escapes exactly as the JSON has
# them; the backend converts them back to newlines.
FIREBASE_PRIVATE_KEY=""
#
# WITHOUT these three, admin routes return 503 when NODE_ENV=production. That is
# deliberate: a console silently protected by a uid in a URL, while everything
# claims otherwise, is worse than one that is plainly broken.

# Sign-in methods the console accepts, comma-separated, matched against the
# token's sign_in_provider. Google only by default — SMS is the weakest link in
# the set and these accounts can read every customer record.
ADMIN_SIGN_IN_PROVIDERS=google.com
# How old an operator's last actual sign-in may be. Not the token lifetime,
# which refreshes silently forever; this is what closes a session left open.
ADMIN_SESSION_MAX_AGE_HOURS=12
# Require a second factor. Off by default because switching it on before
# operators have enrolled locks all of them out, owner included, and Firebase
# MFA needs the project upgraded to Identity Platform. Enrol first, then flip.
ADMIN_REQUIRE_MFA=false

# ---- razorpay ----
# From Dashboard → Settings → API Keys. The key id is public (it is handed to
# the browser to open checkout); the secret signs the checkout callback and
# must never leave the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From Dashboard → Settings → Webhooks. A *different* secret from the one
# above: it signs the webhook body. Without it the webhook rejects every
# delivery, and an order whose customer closed the tab is never marked paid.
# Subscribe the endpoint to payment.captured, order.paid and payment.failed,
# pointing at https://your-domain.com/api/v1/payement/webhook
RAZORPAY_WEBHOOK_SECRET=
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# ---- email (Resend) ----
# Transactional order mail: the paid receipt, shipping and delivery notices,
# and cancellations. Optional — with these unset nothing is sent and the
# message is logged instead, so the store works exactly as it did before.
# Leaving them unset in production is logged as an error rather than ignored,
# because "the receipts silently stopped" is not something anyone notices.
RESEND_API_KEY=
# Must be an address on a domain you have verified in Resend, e.g.
# "The Store <orders@your-domain.com>". An unverified sender is rejected by
# the API, not silently dropped.
MAIL_FROM=
# Appears in the subject lines and the message header.
STORE_NAME=
# Signs the one-click unsubscribe links in non-transactional mail. Optional:
# falls back to RAZORPAY_KEY_SECRET, namespaced so a token minted for one can
# never be a valid signature for the other. Changing it invalidates every
# unsubscribe link already sitting in customers' inboxes.
MAIL_UNSUBSCRIBE_SECRET=

# ---- client build args (baked into the bundle at image build time) ----
# Public origin of the storefront, no trailing slash. nginx serves the SPA and
# proxies /api + /uploads to the backend, so this is the site's own URL.
VITE_SERVER=https://your-domain.com
# API origin for the *console* bundle. Leave empty: nginx proxies /api on the
# admin host as well, so the console is same-origin with the API there. It
# exists only for `npm run dev`, where Vite is on :5173 and the API on :3000.
VITE_ADMIN_SERVER=
VITE_FIREBASE_KEY=
VITE_FIREBASE_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APPID=
VITE_FIREBASE_MEASUREMENT_ID=

# ---- pricing, delivery and returns ----
# Tax and shipping used to be three literals — 0.18, 200 and 1000 — sitting in
# the client's cartReducer and again in the backend's calculateOrderAmounts,
# kept in step by hand. That is the arrangement that shows a customer one total
# in the cart and charges them another at checkout. The server now owns them,
# the storefront reads them from GET /api/v1/config/storefront, and every value
# below is optional: unset reproduces exactly the old hardcoded numbers.
#
# A fraction, not a percentage. 0.18 is 18%.
TAX_RATE=0.18
# Flat delivery charge on orders at or below the free-shipping threshold.
SHIPPING_FEE=200
# Subtotal strictly above this ships free. The threshold beats a zone override
# below — being told "free over ₹1,000" and then charged for a zone is a
# surprise in the most expensive place a shop can put one.
FREE_SHIPPING_THRESHOLD=1000
# Optional per-state overrides as a JSON object, keyed by lowercased state name.
# Malformed JSON is logged and ignored rather than crashing the server.
# e.g. SHIPPING_ZONES={"kerala":150,"assam":250}
SHIPPING_ZONES=
# Days after delivery a customer may still open a return. The clock runs from
# Order.deliveredAt; orders delivered before that column existed have none and
# are treated as still open, so a human decides rather than the schema.
RETURN_WINDOW_DAYS=7

# ---- cash on delivery ----
# Off by default. A COD order skips PendingPayment entirely — there is no
# payment window to run out, so it carries no expiry and the sweep in
# utils/expireOrders.ts never touches it (enforced by a CHECK constraint, not
# just by the controller). Delivery is the payment event: marking a COD order
# Delivered is what records it as Paid.
COD_ENABLED=false
# Refused above this order total. 0 means no ceiling. Checked at checkout as
# well as in the UI — a limit only the browser enforces is not a limit.
COD_MAX_ORDER_VALUE=20000
# Handling charge added to a COD order. Folded into the shipping line rather
# than given a column of its own: the customer reads it there, and a fourth
# money column would have to be added to every total, email and export that
# already agree.
COD_FEE=0

# ---- inventory ----
# What the console calls "running low", in units. Five is right for a shop
# selling furniture and useless for one selling pens.
LOW_STOCK_THRESHOLD=5

# ---- store identity (baked into the client bundle) ----
# Rendered into the policy pages, the contact page and every page title. The
# policies in client/src/pages/static/documents.ts are complete templates with
# visible [bracketed] placeholders for anything the code cannot know — have a
# lawyer read them before launch. Unset values render an obvious placeholder
# rather than a plausible-looking invention: a returns policy stating a made-up
# postal address is not a draft, it is parcels posted somewhere that does not
# exist.
VITE_STORE_NAME=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_STORE_ADDRESS=
# Canonical storefront origin, no trailing slash. Used for <link rel="canonical">
# and the og: tags. The backend builds sitemap.xml and robots.txt from
# CLIENT_URL instead, because those are served from the API.
VITE_SITE_URL=https://your-domain.com

# ---- social profiles (footer) ----
# The footer renders an icon only for a profile whose URL is set, and only for
# an http(s) one. These replaced four `href="#"` placeholders: a click that
# scrolls the page to the top and does nothing reads as a broken site, where a
# missing icon reads as a shop that is not on Pinterest. Leave blank to omit.
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_TWITTER=
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_PINTEREST=

# ---- host ----
# Port nginx binds on the VPS. Use 8080 if something else owns 80/443.
# The production overlay rebinds this to loopback and gives 80/443 to Caddy,
# so this only matters for a base-file-only deploy.
HTTP_PORT=80

# ===========================================================================
# Everything below is read ONLY by docker-compose.prod.yml — the production
# overlay that adds TLS and backups. See docs/deployment.md.
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# A base-file-only deploy (plain HTTP, no backups) ignores all of it.
# ===========================================================================

# ---- tls ----
# The storefront's domain, apex form, no scheme and no trailing slash.
# Caddy obtains certificates for this, www.<this>, and app.admin.<this>, so all
# three need DNS A/AAAA records pointing at this server BEFORE first start —
# issuance fails for any hostname that does not already resolve here.
SITE_DOMAIN=your-domain.com
# Let's Encrypt sends expiry and problem notices here. Without it Caddy
# registers anonymously and nothing warns you when renewals start failing.
ACME_EMAIL=you@your-domain.com

# ---- backups ----
# Host directory the dumps are written to. A bind mount on purpose: a backup
# that exists only inside Docker, on the same disk as the database, does not
# survive losing the disk or the machine. Point something at this directory to
# copy it off the box — that step is what makes these actually backups.
BACKUP_DIR=./backups
# Seconds between dumps. 86400 = daily.
BACKUP_INTERVAL_SECONDS=86400
# Dumps older than this are deleted, but only ever after a successful new one.
BACKUP_RETENTION_DAYS=14
