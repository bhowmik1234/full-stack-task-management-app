# Ignore node_modules in both client and backend
client/node_modules/
backend/node_modules/

# Ignore .env files in both client and backend
client/.env
backend/.env

.env

# Ignore system files
.DS_Store
Thumbs.db

# Ignore logs
*.log
logs/
client/logs/
backend/logs/

# Ignore npm debug files
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore build or dist folders (if applicable)
# client/dist/
# client/build/
# backend/dist/
# backend/build/

# Ignore temporary files
*.tmp
*.swp
*.bak
*.pid

# Ignore IDE/project-specific files
.vscode/
.idea/
*.iml

# Prisma generated client (regenerated by `npx prisma generate`)
backend/src/generated/

# Build output.
#
# backend/dist was committed, and went stale whenever `npm run build` was not
# rerun — a compiled tree in git is a second copy of the source that no tooling
# keeps in step, and the Dockerfile builds it in the image anyway. Untracked
# with `git rm -r --cached backend/dist`; the files stay on disk.
backend/dist/
client/dist/

# Prisma emits the client into the source tree (see the generator block in
# schema.prisma); it is regenerated by `npm run build` and by `prisma generate`.
backend/src/generated/

# Runtime uploads. The volume is the source of truth in a deploy; see
# scripts/import-uploads.sh for moving the historically-committed ones across.
backend/uploads/

# Database dumps written by the backup service (docker-compose.prod.yml).
# Never commit these — they are the entire customer table.
/backups/
